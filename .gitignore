# Ignorar entornos virtuales
venv/
.lokusvenv/
.flet/

# Ignorar archivos de caché de Python
__pycache__/
*.pyc
*.pyd
*.pyo

# Ignorar archivos de configuración sensibles (API Keys)
config/config.py
config/config_local.py
config/settings.json
config/ia_aprendizaje.json*
*.env
*.env.*

# Ignorar dependencias y artefactos de compilación (Rust / Tauri / Node)
node_modules/
src-tauri/target/
src-tauri/gen/

# Ignorar archivos de editor/IDE y escritorio
.vscode/
.idea/
.directory

# Ignorar archivos específicos de sistema operativo
.DS_Store
Thumbs.db

# Ignorar archivos generados por la aplicación
archivos_creados/
*.log

# Ignorar archivos temporales
*.tmp
*.temp
~*

# Ignorar archivos de PyInstaller
build/
dist/
*.spec
GestorAudiencias_v2.0/
