{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokus",
  "mainBinaryName": "Lokus",
  "version": "5.2.1",
  "identifier": "com.josebustamante.gestoraudiencias",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "🏛️ Gestor de Audiencias Judiciales",
        "width": 1400,
        "height": 900,
        "minWidth": 420,
        "minHeight": 380,
        "maximized": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
